{{!< default}}
{{> "header"}}
<main class="ghost-page" id="main">
{{#post}}
<article class="{{post_class}}">
<h1>{{title}}</h1>
{{#if feature_image}}<img class="post-image" src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">{{/if}}
<div class="gh-content">{{content}}</div>
</article>
{{/post}}
</main>
{{> "subpage-footer"}}
