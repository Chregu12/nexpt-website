{{!< default}}
{{#contentFor "pageTitle"}}Nexpt HR · {{/contentFor}}
{{> "header"}}
<main class="subpage product-page product-hr" id="main">
  <section class="product-page-hero scene">
    <div class="eyebrow">Nexpt HR · People Operations</div>
    <h1>Menschen stärken.<br><em>Prozesse klären.</em></h1>
    <p class="subpage-lead">Ein HR-Portal für Organisation, Personalprozesse und Freigaben. Ein persönlicher Bereich, damit Mitarbeitende Zeit, Abwesenheiten, Dokumente und Anliegen selbst verwalten können.</p>
    <div class="hero-actions">
      <a class="button" href="{{@site.url}}/work/kontakt/">Nexpt HR kennenlernen <span aria-hidden="true">↗</span></a>
      <a class="text-link" href="#hr-portale">Zwei Perspektiven ansehen <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="product-stage scene" aria-labelledby="hr-stage-title">
    <div class="product-stage-copy">
      <div class="eyebrow">Vom Eintritt bis zur Entwicklung</div>
      <h2 id="hr-stage-title">Der nächste Schritt ist klar.</h2>
      <p>HR sieht, was ansteht. Mitarbeitende erledigen Anliegen und Einträge im eigenen Bereich. Zuständigkeiten, Freigaben und der Stand eines Vorgangs bleiben nachvollziehbar.</p>
      <div class="product-ink hr-ink" data-product-motion>{{> "motion-hr"}}<button class="animation-toggle" type="button" data-motion-play aria-pressed="false">Animation abspielen</button><span class="ink-caption">Menschen · Abläufe · Entwicklung</span></div>
    </div>
    <div class="product-preview hr-preview" role="img" aria-label="Illustrative Nexpt HR Produktvorschau, keine Live-Personaldaten.">
      <div class="preview-top"><span>NEXPT HR</span><span class="preview-status">BEISPIELANSICHT</span></div>
      <div class="preview-body">
        <div class="preview-rail"><span class="preview-active">Übersicht</span><span>Mitarbeitende</span><span>Ein- und Austritt</span><span>Zeit &amp; Abwesenheit</span><span>Entwicklung</span></div>
        <div class="preview-main">
          <div class="preview-greeting"><small>PERSONALPROZESSE</small><strong>Was steht als Nächstes an?</strong></div>
          <div class="preview-process"><span class="process-dot green-dot">1</span><div><b>Neuer Eintritt vorbereiten</b><small>Onboarding · Zuständigkeiten prüfen</small></div><span class="preview-pill">In Arbeit</span></div>
          <div class="preview-process"><span class="process-dot blue-dot">2</span><div><b>Abwesenheit freigeben</b><small>Team · wartet auf Freigabe</small></div><span class="preview-pill">Offen</span></div>
          <div class="preview-process"><span class="process-dot sand-dot">3</span><div><b>Entwicklungsgespräch planen</b><small>Talent · nächster Schritt</small></div><span class="preview-pill">Geplant</span></div>
        </div>
      </div>
    </div>
  </section>

  <section class="product-feature-grid" aria-label="Bereiche von Nexpt HR">
    <article class="subpage-card scene"><div class="eyebrow">01 / Organisation</div><h2>Menschen und Rollen.</h2><p>Personalprofile, Anstellungen, Positionen, Organisationseinheiten und Standorte im Zusammenhang betrachten.</p></article>
    <article class="subpage-card scene"><div class="eyebrow">02 / Ein- und Austritt</div><h2>Übergänge begleiten.</h2><p>Recruiting, Preboarding, Onboarding, Veränderungen und Austritte über klare Schritte und Zuständigkeiten organisieren.</p></article>
    <article class="subpage-card scene"><div class="eyebrow">03 / Zeit und Alltag</div><h2>Was heute ansteht.</h2><p>Zeiten, Abwesenheiten, Dienstplanung, Spesen und dazugehörige Freigaben im Blick behalten.</p></article>
    <article class="subpage-card scene"><div class="eyebrow">04 / Entwicklung</div><h2>Potenzial weiterentwickeln.</h2><p>Ziele, Kompetenzen, Gespräche, Weiterbildung und Entwicklungsschritte für HR und Teams koordinieren.</p></article>
  </section>

  <section class="portal-section scene" id="hr-portale" aria-labelledby="hr-portale-title">
    <div class="eyebrow">Ein HR-Alltag · zwei Perspektiven</div>
    <h2 id="hr-portale-title">Ein Portal für HR.<br><em>Ein Bereich für Mitarbeitende.</em></h2>
    <div class="portal-grid">
      <article class="portal-card"><span class="portal-index">01</span><h3>HR-Portal</h3><p>Organisation, Ein- und Austritte, Personalvorgänge, Genehmigungen und Auswertungen zentral bearbeiten.</p><div class="use-case-tags"><span>Organisation</span><span>Freigaben</span><span>Onboarding</span></div></article>
      <article class="portal-card"><span class="portal-index">02</span><h3>Mein Bereich</h3><p>Mitarbeitende finden ihre persönlichen Themen an einem Ort: Profil, Zeit, Abwesenheiten, Dokumente, Spesen, Schulungen und Ausrüstung.</p><div class="use-case-tags"><span>Self-Service</span><span>Persönliche Daten</span><span>Alltag</span></div></article>
    </div>
  </section>

  <section class="subpage-section scene">
    <h2>HR und Mitarbeitende.<br>Am selben Prozess.</h2>
    <div><p>Wenn Zuständigkeit, Freigabe und nächster Schritt nachvollziehbar sind, bleibt mehr Zeit für gute Zusammenarbeit. Nexpt HR ordnet den Ablauf so, dass HR und Mitarbeitende ihre jeweilige Sicht behalten.</p><div class="use-case-tags"><span>Menschen</span><span>Prozesse</span><span>Verantwortung</span><span>Entwicklung</span></div></div>
  </section>

  <p class="availability-note">Die Ansichten hier sind illustrative Vorschauen und enthalten keine Live-Personaldaten. Für Fragen zu Zugang und Verfügbarkeit sind wir gern im Gespräch.</p>
</main>
{{> "subpage-footer"}}
